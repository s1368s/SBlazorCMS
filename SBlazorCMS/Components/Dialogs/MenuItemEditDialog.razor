@using System.Security.Claims
@using SBlazorCMS.Infrastructure.Services.Common
@using SBlazorCMS.Infrastructure.Services.MenuItems
@inject IMenuItemService MenuItemService
@inject ILanguageService LanguageService
@inject AuthenticationStateProvider AuthStateProvider

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "افزودن آیتم" : "ویرایش آیتم")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Indeterminate="true" />
            </div>
        }
        else
        {
            <MudGrid Spacing="4">
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="آیتم والد" @bind-Value="_parentId" Clearable="true" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var option in _parentOptions)
                        {
                            <MudSelectItem T="Guid?" Value="option.Id">@option.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int" Label="ترتیب" @bind-Value="_order" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="آدرس (Url)" @bind-Value="_url" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="آدرس تصویر (ImgUrl)" @bind-Value="_imgUrl" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="اطلاعات اضافه" @bind-Value="_extra" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                </MudItem>

                <MudItem xs="12">
                    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
                        @foreach (var lang in _languages)
                        {
                            <MudTabPanel Text="@lang.Name">
                                <MudTextField Label="عنوان" @bind-Value="_translations[lang.Id].Title"
                                              Required="@lang.IsDefault" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 mt-3" />
                            </MudTabPanel>
                        }
                    </MudTabs>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">ذخیره</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid MenuId { get; set; }
    [Parameter] public Guid? MenuItemId { get; set; }

    private bool _isNew => MenuItemId is null;
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;

    private Guid? _parentId;
    private string _url = string.Empty;
    private string _imgUrl = string.Empty;
    private string _extra = string.Empty;
    private int _order;

    private List<LanguageDto> _languages = [];
    private List<MenuItemOptionDto> _parentOptions = [];
    private readonly Dictionary<Guid, MenuItemTranslationInput> _translations = [];

    protected override async Task OnInitializedAsync()
    {
        _languages = await LanguageService.GetActiveLanguagesAsync();
        _parentOptions = await MenuItemService.GetParentOptionsAsync(MenuId, MenuItemId);

        foreach (var lang in _languages)
        {
            _translations[lang.Id] = new MenuItemTranslationInput();
        }

        if (MenuItemId is { } id)
        {
            var editDto = await MenuItemService.GetForEditAsync(id);
            if (editDto is not null)
            {
                _parentId = editDto.ParentId;
                _url = editDto.Url;
                _imgUrl = editDto.ImgUrl;
                _extra = editDto.Extra;
                _order = editDto.Order;
                foreach (var (languageId, translation) in editDto.Translations)
                {
                    _translations[languageId] = translation;
                }
            }
        }

        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        _errorMessage = null;

        var userId = await GetCurrentUserIdAsync();

        var request = new MenuItemSaveRequest
        {
            MenuItemId = MenuItemId,
            MenuId = MenuId,
            ParentId = _parentId,
            Url = _url,
            ImgUrl = _imgUrl,
            Extra = _extra,
            Order = _order,
            Translations = _translations,
            CurrentUserId = userId
        };

        var result = await MenuItemService.SaveAsync(request);

        if (result.Success)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }

        _saving = false;
    }

    private async Task<Guid?> GetCurrentUserIdAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(idClaim, out var id) ? id : null;
    }

    private void Cancel() => MudDialog.Cancel();
}
