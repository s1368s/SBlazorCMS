@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using SBlazorCMS.Domain
@using SBlazorCMS.Infrastructure.Persistence
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "افزودن دسته‌بندی" : "ویرایش دسته‌بندی")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Indeterminate="true" />
            </div>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="دسته والد" @bind-Value="_parentId" Clearable="true" Dense="true">
                        @foreach (var option in _parentOptions)
                        {
                            <MudSelectItem T="Guid?" Value="option.Id">@option.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="قالب (Skin)" @bind-Value="_skinId" Clearable="true" Dense="true">
                        @foreach (var skin in _skins)
                        {
                            <MudSelectItem T="Guid?" Value="skin.Id">@skin.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudNumericField T="int" Label="ترتیب نمایش" @bind-Value="_orderValue" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudNumericField T="int" Label="تعداد نمایش" @bind-Value="_showCount" />
                </MudItem>

                <MudItem xs="12">
                    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
                        @foreach (var lang in _languages)
                        {
                            <MudTabPanel Text="@lang.Name">
                                <MudTextField Label="عنوان" @bind-Value="_translations[lang.Id].Title"
                                              Required="@lang.IsDefault" Class="mb-3" />
                                <MudTextField Label="نامک (Slug)" @bind-Value="_translations[lang.Id].Slug"
                                              Required="@lang.IsDefault" Class="mb-3" />
                                <MudTextField Label="توضیحات" @bind-Value="_translations[lang.Id].Description"
                                              Lines="3" />
                            </MudTabPanel>
                        }
                    </MudTabs>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">ذخیره</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid? CategoryId { get; set; }

    private bool _isNew => CategoryId is null;
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;

    private Guid? _parentId;
    private Guid? _skinId;
    private int _orderValue;
    private int _showCount;

    private List<Language> _languages = [];
    private List<(Guid Id, string Title)> _parentOptions = [];
    private List<Skin> _skins = [];
    private readonly Dictionary<Guid, TranslationInput> _translations = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _languages = await db.Languages.Where(l => l.IsActive).OrderByDescending(l => l.IsDefault).ToListAsync();
        _skins = await db.Skins.ToListAsync();

        foreach (var lang in _languages)
        {
            _translations[lang.Id] = new TranslationInput();
        }

        var defaultLangId = _languages.First(l => l.IsDefault).Id;

        var allCategories = await db.Categories
            .Select(c => new
            {
                c.Id,
                c.ParentId,
                Title = c.Translations.Where(t => t.LanguageId == defaultLangId).Select(t => t.Title).FirstOrDefault()
            })
            .ToListAsync();

        var excluded = new HashSet<Guid>();
        if (CategoryId is { } editingId)
        {
            excluded.Add(editingId);
            var changed = true;
            while (changed)
            {
                changed = false;
                foreach (var c in allCategories)
                {
                    if (c.ParentId.HasValue && excluded.Contains(c.ParentId.Value) && excluded.Add(c.Id))
                    {
                        changed = true;
                    }
                }
            }
        }

        _parentOptions = allCategories
            .Where(c => !excluded.Contains(c.Id))
            .Select(c => (c.Id, c.Title ?? "(بدون عنوان)"))
            .ToList();

        if (CategoryId is { } id)
        {
            var category = await db.Categories.Include(c => c.Translations).FirstOrDefaultAsync(c => c.Id == id);
            if (category is not null)
            {
                _parentId = category.ParentId;
                _skinId = category.SkinId;
                _orderValue = category.OrderValue;
                _showCount = category.ShowCount;
                foreach (var t in category.Translations)
                {
                    _translations[t.LanguageId] = new TranslationInput
                    {
                        Title = t.Title,
                        Slug = t.Slug,
                        Description = t.Description
                    };
                }
            }
        }

        _loading = false;
    }

    private async Task Save()
    {
        var defaultLangId = _languages.First(l => l.IsDefault).Id;
        var defaultTranslation = _translations[defaultLangId];
        if (string.IsNullOrWhiteSpace(defaultTranslation.Title) || string.IsNullOrWhiteSpace(defaultTranslation.Slug))
        {
            _errorMessage = "عنوان و نامک برای زبان پیش‌فرض الزامی است";
            return;
        }

        if (_parentId == CategoryId)
        {
            _errorMessage = "یک دسته‌بندی نمی‌تواند والد خودش باشد";
            return;
        }

        _saving = true;
        _errorMessage = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var userId = await GetCurrentUserIdAsync();

            Category category;
            if (_isNew)
            {
                category = new Category
                {
                    Id = Guid.NewGuid(),
                    CreatedAt = DateTime.UtcNow,
                    CreatedBy = userId
                };
                db.Categories.Add(category);
            }
            else
            {
                category = await db.Categories.Include(c => c.Translations).FirstAsync(c => c.Id == CategoryId);
                category.UpdatedAt = DateTime.UtcNow;
                category.UpdatedBy = userId;
            }

            category.ParentId = _parentId;
            category.SkinId = _skinId;
            category.OrderValue = _orderValue;
            category.ShowCount = _showCount;

            foreach (var lang in _languages)
            {
                var input = _translations[lang.Id];
                var existing = category.Translations.FirstOrDefault(t => t.LanguageId == lang.Id);

                if (string.IsNullOrWhiteSpace(input.Title))
                {
                    if (existing is not null)
                    {
                        category.Translations.Remove(existing);
                        db.Remove(existing);
                    }
                    continue;
                }

                if (existing is null)
                {
                    category.Translations.Add(new CategoryTranslation
                    {
                        Id = Guid.NewGuid(),
                        LanguageId = lang.Id,
                        Title = input.Title,
                        Slug = input.Slug,
                        Description = input.Description
                    });
                }
                else
                {
                    existing.Title = input.Title;
                    existing.Slug = input.Slug;
                    existing.Description = input.Description;
                }
            }

            await db.SaveChangesAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (DbUpdateException)
        {
            _errorMessage = "خطا در ذخیره‌سازی. ممکن است نامک تکراری باشد.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<Guid?> GetCurrentUserIdAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(idClaim, out var id) ? id : null;
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class TranslationInput
    {
        public string Title { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
