@using System.Security.Claims
@using SBlazorCMS.Infrastructure.Services.Categories
@using SBlazorCMS.Infrastructure.Services.Common
@using SBlazorCMS.Infrastructure.Services.Skins
@inject ICategoryService CategoryService
@inject ILanguageService LanguageService
@inject ISkinService SkinService
@inject AuthenticationStateProvider AuthStateProvider

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "افزودن دسته‌بندی" : "ویرایش دسته‌بندی")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Indeterminate="true" />
            </div>
        }
        else
        {
            <MudGrid Spacing="4">
                <MudItem xs="12" sm="6">
                    <MudTextField Label="کد" @bind-Value="_code" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="دسته والد" @bind-Value="_parentId" Clearable="true" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var option in _parentOptions)
                        {
                            <MudSelectItem T="Guid?" Value="option.Id">@option.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="قالب (Skin)" @bind-Value="_skinId" Clearable="true" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var skin in _skins)
                        {
                            <MudSelectItem T="Guid?" Value="skin.Id">@skin.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudNumericField T="int" Label="ترتیب نمایش" @bind-Value="_orderValue" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudNumericField T="int" Label="تعداد نمایش" @bind-Value="_showCount" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
                        @foreach (var lang in _languages)
                        {
                            <MudTabPanel Text="@lang.Name">
                                <MudTextField Label="عنوان" @bind-Value="_translations[lang.Id].Title"
                                              Required="@lang.IsDefault" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 mt-3" />
                                <MudTextField Label="نامک (Slug)" @bind-Value="_translations[lang.Id].Slug"
                                              Required="@lang.IsDefault" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                <MudTextField Label="توضیحات" @bind-Value="_translations[lang.Id].Description"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
                            </MudTabPanel>
                        }
                    </MudTabs>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">ذخیره</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid? CategoryId { get; set; }

    private bool _isNew => CategoryId is null;
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;

    private string _code = string.Empty;
    private Guid? _parentId;
    private Guid? _skinId;
    private int _orderValue;
    private int _showCount;

    private List<LanguageDto> _languages = [];
    private List<CategoryOptionDto> _parentOptions = [];
    private List<SkinListItemDto> _skins = [];
    private readonly Dictionary<Guid, CategoryTranslationInput> _translations = [];

    protected override async Task OnInitializedAsync()
    {
        _languages = await LanguageService.GetActiveLanguagesAsync();
        _skins = await SkinService.GetListAsync();
        _parentOptions = await CategoryService.GetParentOptionsAsync(CategoryId);

        foreach (var lang in _languages)
        {
            _translations[lang.Id] = new CategoryTranslationInput();
        }

        if (CategoryId is { } id)
        {
            var editDto = await CategoryService.GetForEditAsync(id);
            if (editDto is not null)
            {
                _code = editDto.Code;
                _parentId = editDto.ParentId;
                _skinId = editDto.SkinId;
                _orderValue = editDto.OrderValue;
                _showCount = editDto.ShowCount;
                foreach (var (languageId, translation) in editDto.Translations)
                {
                    _translations[languageId] = translation;
                }
            }
        }

        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        _errorMessage = null;

        var userId = await GetCurrentUserIdAsync();

        var request = new CategorySaveRequest
        {
            CategoryId = CategoryId,
            Code = _code,
            ParentId = _parentId,
            SkinId = _skinId,
            OrderValue = _orderValue,
            ShowCount = _showCount,
            Translations = _translations,
            CurrentUserId = userId
        };

        var result = await CategoryService.SaveAsync(request);

        if (result.Success)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }

        _saving = false;
    }

    private async Task<Guid?> GetCurrentUserIdAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(idClaim, out var id) ? id : null;
    }

    private void Cancel() => MudDialog.Cancel();
}
