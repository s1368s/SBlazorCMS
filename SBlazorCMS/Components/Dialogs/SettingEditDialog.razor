@using System.Security.Claims
@using SBlazorCMS.Infrastructure.Services.Settings
@inject ISettingService SettingService
@inject AuthenticationStateProvider AuthStateProvider

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "افزودن تنظیم" : "ویرایش تنظیم")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Indeterminate="true" />
            </div>
        }
        else
        {
            <MudTextField Label="کلید" @bind-Value="_key" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudTextField Label="مقدار" @bind-Value="_value" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">ذخیره</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid? SettingId { get; set; }

    private bool _isNew => SettingId is null;
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;

    private string _key = string.Empty;
    private string _value = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (SettingId is { } id)
        {
            var editDto = await SettingService.GetForEditAsync(id);
            if (editDto is not null)
            {
                _key = editDto.Key;
                _value = editDto.Value;
            }
        }

        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        _errorMessage = null;

        var userId = await GetCurrentUserIdAsync();

        var request = new SettingSaveRequest
        {
            SettingId = SettingId,
            Key = _key,
            Value = _value,
            CurrentUserId = userId
        };

        var result = await SettingService.SaveAsync(request);

        if (result.Success)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }

        _saving = false;
    }

    private async Task<Guid?> GetCurrentUserIdAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(idClaim, out var id) ? id : null;
    }

    private void Cancel() => MudDialog.Cancel();
}
