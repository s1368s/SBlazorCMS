@using System.Security.Claims
@using SBlazorCMS.Infrastructure.Services.Common
@inject ILanguageService LanguageService
@inject AuthenticationStateProvider AuthStateProvider

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "افزودن زبان" : "ویرایش زبان")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Indeterminate="true" />
            </div>
        }
        else
        {
            <MudTextField Label="نام" @bind-Value="_name" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudTextField Label="کد (مثلاً fa یا en)" @bind-Value="_code" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <div class="d-flex align-center gap-4">
                <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Primary" Label="فعال" />
                <MudSwitch T="bool" @bind-Value="_isDefault" Color="Color.Primary" Label="پیش‌فرض" />
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">ذخیره</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid? LanguageId { get; set; }

    private bool _isNew => LanguageId is null;
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;

    private string _name = string.Empty;
    private string _code = string.Empty;
    private bool _isActive = true;
    private bool _isDefault;

    protected override async Task OnInitializedAsync()
    {
        if (LanguageId is { } id)
        {
            var editDto = await LanguageService.GetForEditAsync(id);
            if (editDto is not null)
            {
                _name = editDto.Name;
                _code = editDto.Code;
                _isActive = editDto.IsActive;
                _isDefault = editDto.IsDefault;
            }
        }

        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        _errorMessage = null;

        var userId = await GetCurrentUserIdAsync();

        var request = new LanguageSaveRequest
        {
            LanguageId = LanguageId,
            Name = _name,
            Code = _code,
            IsActive = _isActive,
            IsDefault = _isDefault,
            CurrentUserId = userId
        };

        var result = await LanguageService.SaveAsync(request);

        if (result.Success)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }

        _saving = false;
    }

    private async Task<Guid?> GetCurrentUserIdAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(idClaim, out var id) ? id : null;
    }

    private void Cancel() => MudDialog.Cancel();
}
