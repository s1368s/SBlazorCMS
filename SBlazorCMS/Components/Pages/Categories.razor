@page "/categories"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "categories.manage")]
@using System.Security.Claims
@using SBlazorCMS.Components.Dialogs
@using SBlazorCMS.Infrastructure.Services.Categories
@inject ICategoryService CategoryService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>دسته‌بندی‌ها</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h4">دسته‌بندی‌ها</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
        دسته‌بندی جدید
    </MudButton>
</div>

<MudTable Items="_rows" Hover="true" Dense="true" Elevation="2" Loading="_loading" Class="rounded-lg">
    <HeaderContent>
        <MudTh>ترتیب</MudTh>
        <MudTh>عنوان</MudTh>
        <MudTh>دسته والد</MudTh>
        <MudTh>تعداد نمایش</MudTh>
        <MudTh>عملیات</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="ترتیب">@context.OrderValue</MudTd>
        <MudTd DataLabel="عنوان">@context.Title</MudTd>
        <MudTd DataLabel="دسته والد">@(context.ParentTitle ?? "—")</MudTd>
        <MudTd DataLabel="تعداد نمایش">@context.ShowCount</MudTd>
        <MudTd DataLabel="عملیات">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditDialog(context.Id))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Id))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>هنوز دسته‌بندی‌ای ثبت نشده است</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private bool _loading = true;
    private List<CategoryListItemDto> _rows = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await CategoryService.GetListAsync();
        _loading = false;
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CategoryEditDialog>("دسته‌بندی جدید");
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("دسته‌بندی با موفقیت ثبت شد", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(Guid id)
    {
        var parameters = new DialogParameters<CategoryEditDialog> { { x => x.CategoryId, id } };
        var dialog = await DialogService.ShowAsync<CategoryEditDialog>("ویرایش دسته‌بندی", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("تغییرات ذخیره شد", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "حذف دسته‌بندی",
            "آیا از حذف این دسته‌بندی مطمئن هستید؟",
            yesText: "حذف",
            cancelText: "انصراف");

        if (confirmed != true)
        {
            return;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var userId = Guid.TryParse(userIdClaim, out var parsedId) ? parsedId : (Guid?)null;

        var result = await CategoryService.DeleteAsync(id, userId);
        if (!result.Success)
        {
            Snackbar.Add(result.ErrorMessage!, Severity.Warning);
            return;
        }

        Snackbar.Add("دسته‌بندی حذف شد", Severity.Success);
        await LoadAsync();
    }
}
