@page "/users"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "users.manage")]
@using SBlazorCMS.Components.Dialogs
@using SBlazorCMS.Infrastructure.Services.Users
@inject IUserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>کاربران</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h4">کاربران</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
        کاربر جدید
    </MudButton>
</div>

<MudTable Items="_rows" Hover="true" Dense="true" Elevation="2" Loading="_loading" Class="rounded-lg">
    <HeaderContent>
        <MudTh>نام و نام خانوادگی</MudTh>
        <MudTh>نام کاربری</MudTh>
        <MudTh>ایمیل</MudTh>
        <MudTh>نقش‌ها</MudTh>
        <MudTh>وضعیت</MudTh>
        <MudTh>عملیات</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="نام و نام خانوادگی">@context.FullName</MudTd>
        <MudTd DataLabel="نام کاربری">@context.UserName</MudTd>
        <MudTd DataLabel="ایمیل">@context.Email</MudTd>
        <MudTd DataLabel="نقش‌ها">@context.RoleNames</MudTd>
        <MudTd DataLabel="وضعیت">
            @if (context.IsActive)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small">فعال</MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Default" Size="Size.Small">غیرفعال</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="عملیات">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditDialog(context.Id))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Id))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>هنوز کاربری ثبت نشده است</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private bool _loading = true;
    private List<UserListItemDto> _rows = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await UserService.GetListAsync();
        _loading = false;
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<UserEditDialog>("کاربر جدید");
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("کاربر با موفقیت ثبت شد", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(Guid id)
    {
        var parameters = new DialogParameters<UserEditDialog> { { x => x.UserId, id } };
        var dialog = await DialogService.ShowAsync<UserEditDialog>("ویرایش کاربر", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("تغییرات ذخیره شد", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "حذف کاربر",
            "آیا از حذف این کاربر مطمئن هستید؟",
            yesText: "حذف",
            cancelText: "انصراف");

        if (confirmed != true)
        {
            return;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var userId = Guid.TryParse(userIdClaim, out var parsedId) ? parsedId : (Guid?)null;

        var result = await UserService.DeleteAsync(id, userId);
        if (!result.Success)
        {
            Snackbar.Add(result.ErrorMessage!, Severity.Warning);
            return;
        }

        Snackbar.Add("کاربر حذف شد", Severity.Success);
        await LoadAsync();
    }
}
